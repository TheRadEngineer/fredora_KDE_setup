#!/usr/bin/env bash
# =============================================================================
# 00-host-setup.sh
# Fedora 44 KDE Plasma — Post-Install Host Bootstrap
# Target hardware: ASUS ROG Strix SCAR 16 G634JZR (i9-14900HX + RTX 4080 Laptop)
#
# TWO-PHASE EXECUTION:
#   Phase A: Stage 1 upgrades the kernel. Script detects the mismatch between
#            the running kernel and the newly-installed one, then reboots.
#   Phase B: Script auto-resumes after reboot (via a systemd user unit or a
#            simple state file) and continues from Stage 2 onward.
#
#   In practice: run the script → it reboots partway through → log back in →
#   run the script again → it detects state and skips to where it left off.
#
# WHAT THIS SCRIPT DOES:
#   Pre-flight   — Fedora 44 sanity check, sudo, network, log setup
#   Stage  1     — System upgrade + RPM Fusion + dnf tuning  (may reboot here)
#   Stage  2     — NVIDIA driver (open kernel module) + CUDA runtime
#   Stage  3     — ASUS ROG stack — skips buggy asusd-user
#   Stage  4     — SELinux policy (declarative logind/DRM exception)
#   Stage  5     — Browser: remove Firefox, install Zen via Flatpak (user scope)
#   Stage  6     — Container stack: Docker + NVIDIA Container Toolkit + Distrobox
#   Stage  7     — Snapper: pre/post dnf snapshots, keep last 5 pairs
#   Stage  8     — Lean CLI baseline + programming fonts + Node.js
#   Stage  9     — Programming languages: Python (uv), Rust (rustup), Go, C++
#   Stage 10     — Language servers (LSPs) for all target languages
#   Stage 11     — LazyVim (Neovim distribution)
#   Stage 12     — VS Code (native RPM)
#   Stage 13     — Steam + steam-devices + ProtonUp-Qt
#   Stage 14     — Git config (interactive prompt for primary identity)
#   Stage 15     — Wallpaper (if wallpaper.jpg is next to script)
#   Finalize     — Verification checklist + final reboot prompt
#
# USAGE:
#   Basic:            ./00-host-setup.sh
#   Verbose:          ./00-host-setup.sh --verbose
#   Skip GPU steps:   ./00-host-setup.sh --skip-nvidia --skip-asus
#   Force re-run:     ./00-host-setup.sh --reset-state
#
# IDEMPOTENCY: Safe to rerun. Each step checks whether it's already done.
# =============================================================================

set -uo pipefail

LOG_FILE="${LOG_FILE:-$HOME/fedora-setup.log}"
STATE_DIR="$HOME/.fedora-setup-state"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WALLPAPER_SOURCE="${SCRIPT_DIR}/wallpaper.jpg"
STEP_DELAY="${STEP_DELAY:-3}"
BANNER_DELAY="${BANNER_DELAY:-5}"

SKIP_NVIDIA=false
SKIP_ASUS=false
VERBOSE=false
RESET_STATE=false

for arg in "$@"; do
    case "$arg" in
        --skip-nvidia)  SKIP_NVIDIA=true ;;
        --skip-asus)    SKIP_ASUS=true ;;
        --verbose)      VERBOSE=true ;;
        --reset-state)  RESET_STATE=true ;;
        --help|-h)
            grep -E '^# ' "$0" | head -35
            exit 0
            ;;
        *)
            echo "Unknown flag: $arg" >&2
            exit 1
            ;;
    esac
done

if [[ -t 1 ]]; then
    BOLD=$'\e[1m'; DIM=$'\e[2m'; NORMAL=$'\e[0m'
    RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; BLUE=$'\e[34m'; CYAN=$'\e[36m'
else
    BOLD=""; DIM=""; NORMAL=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""
fi

mkdir -p "$(dirname "$LOG_FILE")"
mkdir -p "$STATE_DIR"

# Reset state if requested
if $RESET_STATE; then
    rm -f "$STATE_DIR"/*
    echo "State reset."
fi

: > "$LOG_FILE"

# --- State tracking ----------------------------------------------------------
# Stages record completion by touching a file in $STATE_DIR.
# is_done <stage_name> checks whether it's been done.
is_done()   { [[ -f "$STATE_DIR/$1.done" ]]; }
mark_done() { touch "$STATE_DIR/$1.done"; }

log()   { echo -e "${DIM}[$(date +%H:%M:%S)]${NORMAL} $*" | tee -a "$LOG_FILE" ; }
info()  { echo -e "${BLUE}${BOLD}[INFO]${NORMAL}  $*" | tee -a "$LOG_FILE" ; }
ok()    { echo -e "${GREEN}${BOLD}[ OK ]${NORMAL}  $*" | tee -a "$LOG_FILE" ; }
warn()  { echo -e "${YELLOW}${BOLD}[WARN]${NORMAL}  $*" | tee -a "$LOG_FILE" ; }
err()   { echo -e "${RED}${BOLD}[FAIL]${NORMAL}  $*" | tee -a "$LOG_FILE" ; }
skip()  { echo -e "${CYAN}${BOLD}[SKIP]${NORMAL}  $*" | tee -a "$LOG_FILE" ; }

banner() {
    local title="$1"
    echo | tee -a "$LOG_FILE"
    echo -e "${BOLD}${BLUE}================================================================${NORMAL}" | tee -a "$LOG_FILE"
    echo -e "${BOLD}${BLUE}  $title${NORMAL}" | tee -a "$LOG_FILE"
    echo -e "${BOLD}${BLUE}================================================================${NORMAL}" | tee -a "$LOG_FILE"
    sleep "$BANNER_DELAY"
}

step() {
    echo | tee -a "$LOG_FILE"
    echo -e "${BOLD}${CYAN}--> $*${NORMAL}" | tee -a "$LOG_FILE"
    sleep "$STEP_DELAY"
}

run() {
    if $VERBOSE; then
        "$@" 2>&1 | tee -a "$LOG_FILE"
        return "${PIPESTATUS[0]}"
    else
        "$@" >> "$LOG_FILE" 2>&1
        return $?
    fi
}

# =============================================================================
# Pre-flight
# =============================================================================
preflight() {
    banner "PRE-FLIGHT CHECKS"

    step "Checking that this is Fedora 44"
    if ! grep -q "Fedora Linux 44" /etc/os-release 2>/dev/null; then
        err "This script is designed for Fedora 44. Detected:"
        grep -E '^(NAME|VERSION)=' /etc/os-release | tee -a "$LOG_FILE"
        exit 1
    fi
    ok "Fedora 44 confirmed"

    step "Checking that this is NOT run as root"
    if [[ $EUID -eq 0 ]]; then
        err "Do not run this script with sudo. It calls sudo internally where needed."
        exit 1
    fi
    ok "Running as user: $USER"

    step "Checking sudo access (you'll be prompted for your password)"
    if ! sudo -v; then
        err "This script requires sudo access."
        exit 1
    fi
    ( while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done ) &
    SUDO_KEEPALIVE_PID=$!
    trap 'kill $SUDO_KEEPALIVE_PID 2>/dev/null || true' EXIT
    ok "Sudo access confirmed and kept alive"

    step "Checking network connectivity"
    if ! curl -s --head --connect-timeout 5 https://fedoraproject.org >/dev/null; then
        err "No network connectivity."
        exit 1
    fi
    ok "Network connectivity confirmed"

    step "Log file: $LOG_FILE"
    step "State directory: $STATE_DIR"
    if [[ -n "$(ls -A "$STATE_DIR" 2>/dev/null)" ]]; then
        info "Resuming — found existing state files:"
        ls "$STATE_DIR" | tee -a "$LOG_FILE"
    else
        info "Fresh run — no prior state"
    fi
    sleep "$STEP_DELAY"
}

# =============================================================================
# STAGE 1 — System upgrade + RPM Fusion + kernel-reboot handling
# =============================================================================
stage_1_system_and_rpmfusion() {
    if is_done "stage_1"; then
        banner "STAGE 1 — SYSTEM UPGRADE + RPM FUSION (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 1 — SYSTEM UPGRADE + RPM FUSION"

    step "Configuring dnf for faster mirrors and parallel downloads"
    if ! grep -q "^fastestmirror=True" /etc/dnf/dnf.conf 2>/dev/null; then
        echo "fastestmirror=True" | sudo tee -a /etc/dnf/dnf.conf > /dev/null
        ok "Enabled fastestmirror"
    else
        skip "fastestmirror already set"
    fi
    if ! grep -q "^max_parallel_downloads=" /etc/dnf/dnf.conf 2>/dev/null; then
        echo "max_parallel_downloads=10" | sudo tee -a /etc/dnf/dnf.conf > /dev/null
        ok "Set max_parallel_downloads=10"
    else
        skip "max_parallel_downloads already set"
    fi

    step "Full system upgrade (this can take a while — grab a coffee)"
    if run sudo dnf upgrade --refresh -y; then
        ok "System fully upgraded"
    else
        err "dnf upgrade failed. Check $LOG_FILE"
        exit 1
    fi

    step "Installing RPM Fusion (free + nonfree)"
    if rpm -q rpmfusion-free-release &>/dev/null && rpm -q rpmfusion-nonfree-release &>/dev/null; then
        skip "RPM Fusion already installed"
    else
        if run sudo dnf install -y \
            "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
            "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"; then
            ok "RPM Fusion installed"
        else
            err "RPM Fusion install failed"
            exit 1
        fi
    fi

    step "Updating core group + appstream metadata"
    run sudo dnf group upgrade -y core || warn "Group upgrade returned nonzero (usually harmless)"
    ok "Group upgrade complete"

    step "Verifying RPM Fusion repositories are registered"
    if dnf repolist 2>/dev/null | grep -qi rpmfusion; then
        ok "RPM Fusion repos confirmed"
    else
        err "RPM Fusion repos not visible. Aborting."
        exit 1
    fi

    mark_done "stage_1"

    # -------- KERNEL REBOOT DETECTION --------
    # If the upgrade installed a newer kernel than we're currently running,
    # NVIDIA akmod (Stage 2) will fail to build against the old kernel.
    # Reboot BEFORE Stage 2, then re-run the script to continue.
    step "Checking for kernel version mismatch"
    local running_kernel newest_kernel
    running_kernel=$(uname -r)
    newest_kernel=$(rpm -q kernel --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}\n' 2>/dev/null \
                     | sort -V | tail -1)
    info "Running kernel:   $running_kernel"
    info "Installed kernel: $newest_kernel"

    if [[ "$running_kernel" != "$newest_kernel" ]]; then
        echo | tee -a "$LOG_FILE"
        warn "==============================================================="
        warn " KERNEL MISMATCH DETECTED"
        warn "==============================================================="
        warn " A newer kernel is installed but you're still running the old one."
        warn " NVIDIA driver install (Stage 2) requires matching kernel headers,"
        warn " so we need to REBOOT into the new kernel before continuing."
        warn ""
        warn " After reboot, log in and re-run this script:"
        warn "   cd $SCRIPT_DIR && ./$(basename "$0")"
        warn ""
        warn " The script will detect completed stages and continue from Stage 2."
        warn "==============================================================="
        echo | tee -a "$LOG_FILE"

        read -r -p "Reboot now? [Y/n] " reboot_answer
        if [[ ! "$reboot_answer" =~ ^[Nn]$ ]]; then
            info "Rebooting in 5 seconds... (Ctrl+C to abort)"
            sleep 5
            sudo systemctl reboot
            exit 0
        else
            err "Cannot continue with kernel mismatch. Reboot manually and re-run."
            exit 1
        fi
    fi
    ok "Kernel matches installed version — continuing"
}

# =============================================================================
# STAGE 2 — NVIDIA
# =============================================================================
stage_2_nvidia() {
    if $SKIP_NVIDIA; then
        banner "STAGE 2 — NVIDIA (SKIPPED via flag)"
        skip "Skipping NVIDIA install"
        mark_done "stage_2"
        return
    fi
    if is_done "stage_2"; then
        banner "STAGE 2 — NVIDIA (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 2 — NVIDIA DRIVER (OPEN KERNEL MODULE)"

    step "Checking for NVIDIA GPU"
    if ! lspci | grep -qi 'nvidia'; then
        warn "No NVIDIA GPU detected. Skipping."
        mark_done "stage_2"
        return
    fi
    ok "NVIDIA GPU detected: $(lspci | grep -i nvidia | head -1)"

    step "Installing akmod-nvidia-open + CUDA runtime libraries"
    if rpm -q akmod-nvidia-open &>/dev/null; then
        skip "akmod-nvidia-open already installed"
    else
        if run sudo dnf install -y akmod-nvidia-open xorg-x11-drv-nvidia-cuda; then
            ok "NVIDIA driver packages installed"
        else
            err "NVIDIA driver install failed"
            exit 1
        fi
    fi

    step "Waiting for akmod to build the kernel module (up to 5 minutes)"
    local waited=0
    local max_wait=300
    while [[ $waited -lt $max_wait ]]; do
        if modinfo -F version nvidia &>/dev/null; then
            ok "NVIDIA kernel module built: version $(modinfo -F version nvidia)"
            break
        fi
        sleep 10
        waited=$((waited + 10))
        info "  ...still building (${waited}s / ${max_wait}s)"
    done
    if [[ $waited -ge $max_wait ]]; then
        warn "Kernel module didn't appear in ${max_wait}s. Forcing build..."
        run sudo akmods --force || err "Forced akmod build failed"
    fi

    step "Checking Secure Boot state"
    local sb_state
    sb_state=$(mokutil --sb-state 2>/dev/null || echo "unknown")
    info "Secure Boot: $sb_state"
    if [[ "$sb_state" == *"enabled"* ]]; then
        warn "Secure Boot is enabled. NVIDIA module may need MOK enrollment."
        warn "See: https://rpmfusion.org/Howto/Secure%20Boot"
    else
        ok "Secure Boot disabled — no MOK enrollment needed"
    fi

    mark_done "stage_2"
}

# =============================================================================
# STAGE 3 — ASUS ROG
# =============================================================================
stage_3_asus() {
    if $SKIP_ASUS; then
        banner "STAGE 3 — ASUS ROG (SKIPPED via flag)"
        skip "Skipping ASUS install"
        mark_done "stage_3"
        return
    fi
    if is_done "stage_3"; then
        banner "STAGE 3 — ASUS ROG (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 3 — ASUS ROG HARDWARE STACK"

    step "Detecting ASUS ROG hardware"
    if ! grep -qi 'asus' /sys/class/dmi/id/board_vendor 2>/dev/null; then
        warn "Not an ASUS machine. Skipping ASUS stack."
        mark_done "stage_3"
        return
    fi
    ok "ASUS hardware detected: $(cat /sys/class/dmi/id/product_name 2>/dev/null)"

    step "Enabling the lukenukem/asus-linux COPR repository"
    if dnf copr list --enabled 2>/dev/null | grep -q lukenukem/asus-linux; then
        skip "asus-linux COPR already enabled"
    else
        if run sudo dnf copr enable -y lukenukem/asus-linux; then
            ok "COPR enabled"
        else
            err "Failed to enable asus-linux COPR"
            return
        fi
    fi

    step "Installing asusctl, ROG Control Center, and supergfxctl"
    local asus_pkgs=(asusctl asusctl-rog-gui supergfxctl)
    local to_install=()
    for pkg in "${asus_pkgs[@]}"; do
        rpm -q "$pkg" &>/dev/null || to_install+=("$pkg")
    done
    if [[ ${#to_install[@]} -eq 0 ]]; then
        skip "All ASUS packages already installed"
    else
        if run sudo dnf install -y "${to_install[@]}"; then
            ok "Installed: ${to_install[*]}"
        else
            err "ASUS package install failed"
            return
        fi
    fi

    step "Enabling supergfxd + asus-shutdown services"
    # NOTE: We deliberately do NOT create asusd-user.service. On the ROG Strix
    #       SCAR 16 (Ada-era) it crashes on a Rust unwrap() against a D-Bus
    #       object that doesn't exist on this hardware. asusd.service uses D-Bus
    #       activation and starts automatically as needed.
    run sudo systemctl daemon-reload
    for svc in supergfxd.service asus-shutdown.service; do
        if systemctl list-unit-files "$svc" &>/dev/null; then
            if run sudo systemctl enable --now "$svc"; then
                ok "Enabled $svc"
            else
                warn "Failed to enable $svc"
            fi
        else
            skip "$svc not installed (may be normal)"
        fi
    done

    step "Setting GPU mode to Hybrid (iGPU + dGPU coexisting)"
    if command -v supergfxctl &>/dev/null; then
        local current_mode
        current_mode=$(supergfxctl -g 2>/dev/null || echo "unknown")
        if [[ "$current_mode" == "Hybrid" ]]; then
            skip "GPU mode already Hybrid"
        else
            info "Current mode: $current_mode -> switching to Hybrid"
            run sudo supergfxctl -m Hybrid || warn "Mode switch may need a reboot"
            ok "Hybrid mode requested"
        fi
    else
        warn "supergfxctl not found"
    fi

    step "Reloading udev rules for hardware permissions"
    run sudo udevadm control --reload
    run sudo udevadm trigger
    ok "udev reloaded"

    mark_done "stage_3"
}

# =============================================================================
# STAGE 4 — SELinux
# =============================================================================
stage_4_selinux() {
    if is_done "stage_4"; then
        banner "STAGE 4 — SELINUX (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 4 — SELINUX POLICY EXCEPTIONS"

    step "Installing SELinux policy tooling"
    if ! command -v audit2allow &>/dev/null; then
        run sudo dnf install -y policycoreutils-python-utils checkpolicy || \
            warn "Could not install SELinux tools"
    else
        skip "SELinux tools already present"
    fi

    step "Installing declarative logind/DRM policy module"
    local pol_dir="/tmp/fedora-setup-selinux"
    mkdir -p "$pol_dir"

    cat > "$pol_dir/my-systemdlogind.te" <<'EOF'
module my-systemdlogind 1.0;

require {
    type xserver_misc_device_t;
    type systemd_logind_t;
    class chr_file { read write };
}

# Allow systemd-logind to read/write GPU character device (card0).
# Needed on hybrid-graphics laptops after supergfxctl mode changes.
allow systemd_logind_t xserver_misc_device_t:chr_file { read write };
EOF

    if sudo semodule -l | grep -q "^my-systemdlogind$"; then
        skip "my-systemdlogind policy already loaded"
    else
        pushd "$pol_dir" > /dev/null
        if run checkmodule -M -m -o my-systemdlogind.mod my-systemdlogind.te \
            && run semodule_package -o my-systemdlogind.pp -m my-systemdlogind.mod \
            && run sudo semodule -X 300 -i my-systemdlogind.pp; then
            ok "SELinux policy my-systemdlogind installed at priority 300"
        else
            warn "SELinux policy install failed"
        fi
        popd > /dev/null
    fi

    mark_done "stage_4"
}

# =============================================================================
# STAGE 5 — Browser (Flatpak USER SCOPE)
# =============================================================================
stage_5_browser() {
    if is_done "stage_5"; then
        banner "STAGE 5 — BROWSER (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 5 — BROWSER: REMOVE FIREFOX, INSTALL ZEN"

    step "Ensuring Flathub is enabled (user scope)"
    # KDE Discover's flatpak setup is often locked down at system level;
    # user-scope avoids permission issues on single-user machines.
    if flatpak --user remotes 2>/dev/null | grep -q flathub; then
        skip "Flathub already configured (user scope)"
    else
        if run flatpak remote-add --user --if-not-exists flathub \
            https://dl.flathub.org/repo/flathub.flatpakrepo; then
            ok "Flathub added (user scope)"
        else
            warn "Failed to add Flathub — trying system scope with sudo"
            run sudo flatpak remote-add --if-not-exists flathub \
                https://dl.flathub.org/repo/flathub.flatpakrepo \
                && ok "Flathub added (system scope)" \
                || warn "Both user and system Flathub add failed"
        fi
    fi

    step "Removing Firefox (RPM)"
    if rpm -q firefox &>/dev/null; then
        run sudo dnf remove -y firefox && ok "Firefox removed" || warn "Firefox removal failed"
    else
        skip "Firefox not installed"
    fi

    step "Installing Zen browser via Flatpak (user scope)"
    if flatpak --user list --app 2>/dev/null | grep -q "app.zen_browser.zen"; then
        skip "Zen browser already installed (user)"
    elif flatpak list --app 2>/dev/null | grep -q "app.zen_browser.zen"; then
        skip "Zen browser already installed (system)"
    else
        if run flatpak install --user -y --noninteractive flathub app.zen_browser.zen; then
            ok "Zen browser installed (user)"
        else
            warn "Zen browser install failed — you can install manually later"
        fi
    fi

    step "Setting Zen browser as default"
    # Give the .desktop file a moment to register with xdg
    sleep 2
    if flatpak --user list --app 2>/dev/null | grep -q "app.zen_browser.zen" \
        || flatpak list --app 2>/dev/null | grep -q "app.zen_browser.zen"; then
        run xdg-settings set default-web-browser app.zen_browser.zen.desktop \
            && ok "Zen set as default" \
            || warn "Could not set as default automatically — set via KDE Settings > Default Applications"
    else
        warn "Zen not installed — cannot set as default"
    fi

    mark_done "stage_5"
}

# =============================================================================
# STAGE 6 — Container stack
# =============================================================================
stage_6_containers() {
    if is_done "stage_6"; then
        banner "STAGE 6 — CONTAINERS (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 6 — CONTAINER STACK"

    step "Adding Docker CE repository"
    if [[ -f /etc/yum.repos.d/docker-ce.repo ]]; then
        skip "Docker repo already configured"
    else
        run sudo dnf install -y dnf-plugins-core
        if run sudo dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo; then
            ok "Docker CE repo added"
        else
            err "Failed to add Docker repo"
            return
        fi
    fi

    step "Installing Docker CE + Compose + Buildx"
    if rpm -q docker-ce &>/dev/null; then
        skip "Docker already installed"
    else
        if run sudo dnf install -y docker-ce docker-ce-cli containerd.io \
            docker-buildx-plugin docker-compose-plugin; then
            ok "Docker installed"
        else
            err "Docker install failed"
            return
        fi
    fi

    step "Enabling Docker service"
    run sudo systemctl enable --now docker && ok "Docker service running" || warn "Enable failed"

    step "Adding $USER to the docker group"
    if id -nG "$USER" | grep -qw docker; then
        skip "$USER already in docker group"
    else
        run sudo usermod -aG docker "$USER"
        warn "Log out and back in (or reboot) for docker group membership to apply"
    fi

    step "Adding NVIDIA Container Toolkit repository"
    if [[ -f /etc/yum.repos.d/nvidia-container-toolkit.repo ]]; then
        skip "NVIDIA Container Toolkit repo already configured"
    else
        if curl -s -L https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo \
            | sudo tee /etc/yum.repos.d/nvidia-container-toolkit.repo > /dev/null; then
            ok "NVIDIA Container Toolkit repo added"
        else
            warn "Failed to add repo"
        fi
    fi

    step "Installing NVIDIA Container Toolkit"
    if rpm -q nvidia-container-toolkit &>/dev/null; then
        skip "nvidia-container-toolkit already installed"
    else
        run sudo dnf install -y nvidia-container-toolkit && ok "Installed" || warn "Install failed"
    fi

    step "Configuring Docker to use NVIDIA runtime"
    if command -v nvidia-ctk &>/dev/null; then
        if run sudo nvidia-ctk runtime configure --runtime=docker \
            && run sudo systemctl restart docker; then
            ok "Docker configured for NVIDIA GPU passthrough"
        else
            warn "NVIDIA runtime config failed"
        fi
    fi

    step "Installing Podman + Distrobox"
    if rpm -q distrobox &>/dev/null; then
        skip "Distrobox already installed"
    else
        run sudo dnf install -y distrobox podman && ok "Installed" || warn "Install failed"
    fi

    mark_done "stage_6"
}

# =============================================================================
# STAGE 7 — Snapper
# =============================================================================
stage_7_snapshots() {
    if is_done "stage_7"; then
        banner "STAGE 7 — SNAPPER (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 7 — BTRFS SNAPSHOTS (Snapper)"

    step "Checking filesystem type"
    local root_fs
    root_fs=$(findmnt -no FSTYPE /)
    if [[ "$root_fs" != "btrfs" ]]; then
        warn "Root filesystem is $root_fs, not btrfs. Skipping."
        mark_done "stage_7"
        return
    fi
    ok "Root is btrfs"

    step "Installing snapper + dnf plugin"
    if rpm -q snapper &>/dev/null; then
        skip "Snapper already installed"
    else
        run sudo dnf install -y snapper python3-dnf-plugin-snapper \
            && ok "Snapper + dnf plugin installed" || warn "Install failed"
    fi

    step "Creating root snapshot config"
    if sudo snapper -c root list &>/dev/null; then
        skip "Snapper 'root' config already exists"
    else
        if run sudo snapper -c root create-config /; then
            ok "Snapper 'root' config created"
        else
            warn "Config creation failed"
            mark_done "stage_7"
            return
        fi
    fi

    step "Configuring Snapper policy (pre/post only, keep last 5 pairs, no timeline)"
    sudo snapper -c root set-config TIMELINE_CREATE="no"
    sudo snapper -c root set-config NUMBER_CLEANUP="yes"
    sudo snapper -c root set-config NUMBER_LIMIT="10"
    sudo snapper -c root set-config NUMBER_LIMIT_IMPORTANT="5"
    sudo snapper -c root set-config NUMBER_MIN_AGE="1800"
    sudo snapper -c root set-config EMPTY_PRE_POST_CLEANUP="yes"
    ok "Snapper policy configured"

    step "Disabling snapper-timeline.timer"
    run sudo systemctl disable --now snapper-timeline.timer 2>/dev/null || true
    ok "Timeline timer disabled"

    step "Enabling snapper-cleanup.timer"
    run sudo systemctl enable --now snapper-cleanup.timer && ok "Cleanup timer enabled" || warn "Failed"

    info "Snapper will snapshot / before/after every dnf transaction."
    info "List:   sudo snapper -c root list"
    info "Undo:   sudo snapper -c root undochange N..M"

    mark_done "stage_7"
}

# =============================================================================
# STAGE 8 — CLI baseline + fonts + Node
# =============================================================================
stage_8_cli_baseline() {
    if is_done "stage_8"; then
        banner "STAGE 8 — CLI BASELINE (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 8 — CLI BASELINE + FONTS + NODE.JS"

    step "Installing lean CLI toolchain"
    local cli_pkgs=(
        git gh
        curl wget
        htop btop
        tree
        jq
        ripgrep
        unzip zip xz tar
        neovim
    )
    run sudo dnf install -y "${cli_pkgs[@]}" && ok "CLI toolchain installed" || warn "Partial failure"

    step "Installing programming fonts"
    run sudo dnf install -y jetbrains-mono-fonts-all fira-code-fonts google-noto-fonts-common \
        && ok "Fonts installed" || warn "Partial failure"

    step "Installing Node.js + npm (needed for several LSPs)"
    if command -v node &>/dev/null && command -v npm &>/dev/null; then
        skip "Node.js already installed ($(node --version))"
    else
        run sudo dnf install -y nodejs npm \
            && ok "Node.js installed: $(node --version 2>/dev/null || echo unknown)" \
            || warn "Node.js install failed"
    fi

    mark_done "stage_8"
}

# =============================================================================
# STAGE 9 — Programming languages
# =============================================================================
stage_9_languages() {
    if is_done "stage_9"; then
        banner "STAGE 9 — LANGUAGES (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 9 — PROGRAMMING LANGUAGES"

    step "Installing uv (Python project + package manager)"
    if command -v uv &>/dev/null || [[ -x "$HOME/.local/bin/uv" ]]; then
        skip "uv already installed"
    else
        if run bash -c 'curl -LsSf https://astral.sh/uv/install.sh | sh'; then
            ok "uv installed to ~/.local/bin/uv"
            info "You may need a new shell for uv to be on PATH"
        else
            warn "uv install failed"
        fi
    fi

    step "Installing Go"
    if rpm -q golang &>/dev/null; then
        skip "Go already installed"
    else
        run sudo dnf install -y golang && ok "Go installed" || warn "Install failed"
    fi

    step "Installing Rust via rustup"
    if command -v rustup &>/dev/null || [[ -x "$HOME/.cargo/bin/rustup" ]]; then
        skip "rustup already installed"
    else
        if run bash -c 'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable'; then
            ok "rustup + Rust stable installed to ~/.cargo"
            info "You may need a new shell for cargo/rustc to be on PATH"
        else
            warn "rustup install failed"
        fi
    fi

    step "Installing C++ toolchain"
    local cpp_pkgs=(
        gcc gcc-c++ make cmake ninja-build
        gdb valgrind
        clang clang-tools-extra
        pkg-config
    )
    run sudo dnf install -y "${cpp_pkgs[@]}" && ok "C++ toolchain installed" || warn "Partial failure"

    mark_done "stage_9"
}

# =============================================================================
# STAGE 10 — Language servers
# =============================================================================
stage_10_lsps() {
    if is_done "stage_10"; then
        banner "STAGE 10 — LSPs (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 10 — LANGUAGE SERVERS (LSPs)"

    # Source cargo env so rustup/cargo are on PATH within this session
    [[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

    step "Confirming clangd (C/C++) is available"
    if command -v clangd &>/dev/null; then
        ok "clangd found: $(clangd --version 2>/dev/null | head -1)"
    else
        warn "clangd not found — should have come from clang-tools-extra"
    fi

    step "Installing rust-analyzer via rustup"
    if command -v rustup &>/dev/null; then
        run rustup component add rust-analyzer \
            && ok "rust-analyzer installed" || warn "Install failed"
    else
        warn "rustup not on PATH — run: rustup component add rust-analyzer"
    fi

    step "Installing gopls (Go LSP)"
    if command -v go &>/dev/null; then
        export PATH="$PATH:$HOME/go/bin"
        run go install golang.org/x/tools/gopls@latest \
            && ok "gopls installed to ~/go/bin/gopls" || warn "Install failed"
    else
        warn "Go not on PATH"
    fi

    step "Installing Node.js-based LSPs (npm global)"
    if command -v npm &>/dev/null; then
        local npm_lsps=(
            pyright
            bash-language-server
            yaml-language-server
            dockerfile-language-server-nodejs
            vscode-langservers-extracted
            typescript typescript-language-server
        )
        run sudo npm install -g "${npm_lsps[@]}" \
            && ok "Node LSPs installed" || warn "Partial failure"
    else
        warn "npm not on PATH"
    fi

    step "Installing lua-language-server (dnf)"
    if rpm -q lua-language-server &>/dev/null; then
        skip "lua-language-server already installed"
    else
        run sudo dnf install -y lua-language-server && ok "Installed" || warn "Install failed"
    fi

    step "Installing Java 21 JDK (for LineageOS work + jdtls)"
    if rpm -q java-21-openjdk-devel &>/dev/null; then
        skip "Java 21 JDK already installed"
    else
        run sudo dnf install -y java-21-openjdk-devel && ok "Installed" || warn "Install failed"
    fi
    info "jdtls (Java LSP) auto-installed by LazyVim's Mason on first .java open."

    step "Installing XML LSP (lemminx if in repos)"
    if command -v lemminx &>/dev/null; then
        skip "lemminx already installed"
    else
        if run sudo dnf install -y lemminx; then
            ok "lemminx installed"
        else
            info "lemminx not in Fedora repos — Mason will handle it"
        fi
    fi

    step "Installing marksman (Markdown LSP) via cargo"
    if command -v marksman &>/dev/null; then
        skip "marksman already installed"
    else
        if command -v cargo &>/dev/null; then
            run cargo install --locked marksman \
                && ok "marksman installed to ~/.cargo/bin" || warn "Install failed"
        else
            warn "cargo not on PATH — Mason will handle marksman later"
        fi
    fi

    mark_done "stage_10"
}

# =============================================================================
# STAGE 11 — LazyVim
# =============================================================================
stage_11_lazyvim() {
    if is_done "stage_11"; then
        banner "STAGE 11 — LAZYVIM (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 11 — LAZYVIM"

    step "Backing up any existing Neovim config"
    if [[ -d "$HOME/.config/nvim" ]] && [[ ! -f "$HOME/.config/nvim/.lazyvim-installed" ]]; then
        local ts
        ts=$(date +%Y%m%d-%H%M%S)
        mv "$HOME/.config/nvim" "$HOME/.config/nvim.backup.$ts"
        info "Backed up existing config to nvim.backup.$ts"
    fi

    step "Cloning LazyVim starter"
    if [[ -f "$HOME/.config/nvim/.lazyvim-installed" ]]; then
        skip "LazyVim already installed"
    else
        if run git clone https://github.com/LazyVim/starter "$HOME/.config/nvim"; then
            rm -rf "$HOME/.config/nvim/.git"
            touch "$HOME/.config/nvim/.lazyvim-installed"
            ok "LazyVim starter cloned"
        else
            warn "Failed to clone LazyVim starter"
            mark_done "stage_11"
            return
        fi
    fi

    info "First 'nvim' launch takes ~30s to bootstrap plugins."
    info "Treesitter parsers auto-install per language on first file open."

    mark_done "stage_11"
}

# =============================================================================
# STAGE 12 — VS Code
# =============================================================================
stage_12_vscode() {
    if is_done "stage_12"; then
        banner "STAGE 12 — VS CODE (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 12 — VS CODE"

    step "Adding Microsoft VS Code repository"
    if [[ -f /etc/yum.repos.d/vscode.repo ]]; then
        skip "VS Code repo already configured"
    else
        run sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
        cat <<EOF | sudo tee /etc/yum.repos.d/vscode.repo > /dev/null
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
autorefresh=1
type=rpm-md
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
EOF
        ok "VS Code repo added"
    fi

    step "Installing VS Code"
    if rpm -q code &>/dev/null; then
        skip "VS Code already installed"
    else
        run sudo dnf install -y code && ok "VS Code installed" || warn "Install failed"
    fi

    info "Turn off telemetry: File > Preferences > Settings > search 'telemetry' > 'off'"

    mark_done "stage_12"
}

# =============================================================================
# STAGE 13 — Steam
# =============================================================================
stage_13_steam() {
    if is_done "stage_13"; then
        banner "STAGE 13 — STEAM (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 13 — STEAM + CONTROLLER SUPPORT + PROTONUP-QT"

    step "Installing Steam"
    if rpm -q steam &>/dev/null; then
        skip "Steam already installed"
    else
        run sudo dnf install -y steam && ok "Steam installed" || warn "Install failed"
    fi

    step "Installing steam-devices (controller udev rules)"
    if rpm -q steam-devices &>/dev/null; then
        skip "steam-devices already installed"
    else
        run sudo dnf install -y steam-devices && ok "Installed" || warn "Install failed"
    fi

    step "Installing ProtonUp-Qt (Flatpak — user scope)"
    if flatpak --user list --app 2>/dev/null | grep -q "net.davidotek.pupgui2" \
        || flatpak list --app 2>/dev/null | grep -q "net.davidotek.pupgui2"; then
        skip "ProtonUp-Qt already installed"
    else
        run flatpak install --user -y --noninteractive flathub net.davidotek.pupgui2 \
            && ok "ProtonUp-Qt installed (user)" || warn "Install failed"
    fi

    mark_done "stage_13"
}

# =============================================================================
# STAGE 14 — Git config
# =============================================================================
stage_14_git_config() {
    if is_done "stage_14"; then
        banner "STAGE 14 — GIT CONFIG (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 14 — GIT CONFIGURATION"

    step "Setting up primary git identity"

    local existing_name existing_email
    existing_name=$(git config --global user.name 2>/dev/null || echo "")
    existing_email=$(git config --global user.email 2>/dev/null || echo "")

    if [[ -n "$existing_name" && -n "$existing_email" ]]; then
        info "Git identity already configured: $existing_name <$existing_email>"
        read -r -p "Overwrite? [y/N] " overwrite
        if [[ ! "$overwrite" =~ ^[Yy]$ ]]; then
            skip "Keeping existing git identity"
            mark_done "stage_14"
            return
        fi
    fi

    read -r -p "Primary git user.name (e.g. Your Name): " git_name
    read -r -p "Primary git user.email: " git_email

    if [[ -z "$git_name" || -z "$git_email" ]]; then
        warn "Empty name or email — skipping git config"
        mark_done "stage_14"
        return
    fi

    git config --global user.name "$git_name"
    git config --global user.email "$git_email"
    git config --global init.defaultBranch main
    git config --global pull.rebase false
    git config --global core.editor "nvim"
    ok "Git configured for $git_name <$git_email>"

    info "For multi-identity (2nd/work account), see the note at end of setup."

    mark_done "stage_14"
}

# =============================================================================
# STAGE 15 — Wallpaper
# =============================================================================
stage_15_wallpaper() {
    if is_done "stage_15"; then
        banner "STAGE 15 — WALLPAPER (already done — skipping)"
        skip "Already completed on previous run"
        return
    fi

    banner "STAGE 15 — WALLPAPER"

    if [[ ! -f "$WALLPAPER_SOURCE" ]]; then
        skip "No wallpaper.jpg found next to script — skipping"
        mark_done "stage_15"
        return
    fi

    step "Copying wallpaper to ~/Pictures/wallpapers/"
    mkdir -p "$HOME/Pictures/wallpapers"
    cp "$WALLPAPER_SOURCE" "$HOME/Pictures/wallpapers/setup-wallpaper.jpg"
    ok "Wallpaper copied"

    step "Applying wallpaper via KDE plasma scripting"
    local qdbus_cmd
    qdbus_cmd=$(command -v qdbus6 || command -v qdbus || echo "")
    if [[ -n "$qdbus_cmd" ]]; then
        "$qdbus_cmd" org.kde.plasmashell /PlasmaShell \
            org.kde.PlasmaShell.evaluateScript "
            var allDesktops = desktops();
            for (var i = 0; i < allDesktops.length; i++) {
                d = allDesktops[i];
                d.wallpaperPlugin = 'org.kde.image';
                d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
                d.writeConfig('Image', 'file://$HOME/Pictures/wallpapers/setup-wallpaper.jpg');
            }" 2>&1 | tee -a "$LOG_FILE"
        ok "Wallpaper applied"
    else
        warn "qdbus not available — set wallpaper manually via KDE settings"
    fi

    mark_done "stage_15"
}

# =============================================================================
# Finalize
# =============================================================================
finalize() {
    banner "SETUP COMPLETE"

    echo -e "${GREEN}${BOLD}Post-install setup finished.${NORMAL}" | tee -a "$LOG_FILE"
    echo -e "Log file: ${BOLD}$LOG_FILE${NORMAL}" | tee -a "$LOG_FILE"
    echo -e "State dir: ${BOLD}$STATE_DIR${NORMAL} (safe to delete if you want a fresh run)" | tee -a "$LOG_FILE"

    cat <<'EOF' | tee -a "$LOG_FILE"

╔══════════════════════════════════════════════════════════════╗
║  POST-REBOOT VERIFICATION CHECKLIST                          ║
╚══════════════════════════════════════════════════════════════╝

  Hardware:
    nvidia-smi                # Should show your RTX 4080
    supergfxctl -g            # Should show Hybrid
    asusctl profile -p        # Should show current power profile

  Containers:
    docker run hello-world    # Should succeed without sudo
    docker run --rm --gpus all nvidia/cuda:12.4.0-base-ubuntu22.04 nvidia-smi
                              # Should show your GPU inside a container

  Languages:
    python3 --version         # System Python
    uv --version              # uv Python manager
    go version                # Go
    rustc --version           # Rust (open new shell first)
    g++ --version             # C++
    node --version            # Node.js

  Editors:
    nvim                      # LazyVim bootstraps plugins (~30s first time)
    code                      # VS Code launches

╔══════════════════════════════════════════════════════════════╗
║  IMPORTANT NOTES                                             ║
╚══════════════════════════════════════════════════════════════╝

  1. GAMING ON HYBRID GRAPHICS:
     For AAA games in Steam, right-click game → Properties → Launch Options:
       __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia %command%
     This forces games to use the dGPU (RTX 4080) instead of iGPU.

  2. PROTON GE FOR AAA GAMES:
     Open ProtonUp-Qt from your app menu, click "Add Version",
     pick latest Proton GE, install. Then in Steam → Settings → Compatibility,
     select Proton GE for specific games (Cyberpunk benefits especially).

  3. MULTI-ACCOUNT GIT SETUP:
     For a second personal or work GitHub account, use conditional includes.
     Example ~/.gitconfig addition:
       [includeIf "gitdir:~/dev/personal-2/"]
           path = ~/.gitconfig-personal-2
     Then ~/.gitconfig-personal-2 has its own [user] block.

  4. SSH KEYS FOR GITHUB:
     Manual setup:
       ssh-keygen -t ed25519 -C "your-email@example.com"
     Then add ~/.ssh/id_ed25519.pub to GitHub → Settings → SSH Keys.

  5. SNAPSHOTS:
     List:    sudo snapper -c root list
     Undo:    sudo snapper -c root undochange N..M

EOF

    echo -e "${YELLOW}${BOLD}A REBOOT is required to:${NORMAL}" | tee -a "$LOG_FILE"
    echo "  - Activate docker group membership for $USER" | tee -a "$LOG_FILE"
    echo "  - Make uv, cargo, rustc, gopls available on PATH" | tee -a "$LOG_FILE"
    echo "  - Fully apply Hybrid GPU mode via supergfxctl" | tee -a "$LOG_FILE"
    echo | tee -a "$LOG_FILE"

    read -r -p "Reboot now? [Y/n] " reboot_answer
    if [[ ! "$reboot_answer" =~ ^[Nn]$ ]]; then
        info "Rebooting in 5 seconds... (Ctrl+C to abort)"
        sleep 5
        sudo systemctl reboot
    else
        info "Reboot skipped. Run 'sudo systemctl reboot' when you're ready."
    fi
}

# =============================================================================
# Main
# =============================================================================
main() {
    banner "FEDORA 44 KDE — HOST BOOTSTRAP"
    info "Log file: $LOG_FILE"
    info "State dir: $STATE_DIR"
    info "Verbose: $VERBOSE | Skip NVIDIA: $SKIP_NVIDIA | Skip ASUS: $SKIP_ASUS"

    preflight
    stage_1_system_and_rpmfusion   # May reboot here on kernel mismatch
    stage_2_nvidia
    stage_3_asus
    stage_4_selinux
    stage_5_browser
    stage_6_containers
    stage_7_snapshots
    stage_8_cli_baseline
    stage_9_languages
    stage_10_lsps
    stage_11_lazyvim
    stage_12_vscode
    stage_13_steam
    stage_14_git_config
    stage_15_wallpaper
    finalize
}

main
